# ----- Core -----
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# ----- Database / cache (leave blank to boot in degraded mode) -----
# Local docker-compose:  postgresql://entrix:entrix@localhost:5432/entrix
# Managed (Neon, etc):   postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=
# REDIS_URL enables the durable BullMQ provisioning queue (crash-safe: paid
# orders survive a restart and are retried/recovered). Leave blank to run the
# provisioning saga in-process (fine for dev/mock; NOT crash-safe).
# Local docker-compose:  redis://localhost:6379
# Managed (Memorystore/Upstash): redis://HOST:PORT  or  rediss://...:PORT (TLS)
REDIS_URL=

# ----- Celitech (eSIM supplier) -----
# mock = no real account, no billable purchases; live = real OAuth2 credentials.
# NOTE: Celitech billing is POSTPAID (monthly Stripe invoice) — every live
# purchase is a real charge; there is no free sandbox.
CELITECH_MODE=mock
CELITECH_CLIENT_ID=
CELITECH_CLIENT_SECRET=
# SDK environment (only PRODUCTION today; flip to a sandbox value if/when offered).
CELITECH_ENVIRONMENT=PRODUCTION

# ----- Paystack (payments) -----
# mock = no real account, no billable charges; live = real keys.
# Use a Paystack Kenya account (charges in KES; supports M-Pesa + cards).
# Webhooks are verified by HMAC-SHA512 signature over the raw body using the
# secret key — set the webhook URL in your Paystack dashboard to:
#   https://<your-api-host>/api/v1/webhooks/paystack
PAYSTACK_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ----- Pricing engine -----
PRICING_FX_BUFFER_PCT=0.03
PRICING_MARGIN_PCT=0.35
PRICING_PROCESSOR_FEE_PCT=0.035
PRICING_ROUND_TO=0.5
FX_USD_KES_FALLBACK=129

# ----- Email (login OTP + eSIM delivery) -----
# mock = logs; smtp = real email via ANY provider (Resend/SendGrid/SES/Postmark/Gmail).
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GlobalSimify <support@globalsimify.com>

# ----- WhatsApp (eSIM delivery) — Meta WhatsApp Cloud API -----
# mock = logs; meta = real. Requires an approved message template for delivery.
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# ----- Google Sign-In (verify ID tokens) � same value as web NEXT_PUBLIC_GOOGLE_CLIENT_ID -----
GOOGLE_CLIENT_ID=
# Apple Sign-In: your Services ID (audience of Apple id_tokens). Same as web NEXT_PUBLIC_APPLE_CLIENT_ID.
APPLE_CLIENT_ID=

# ----- SMS + phone OTP (ON HOLD — kept for future use) -----
# Active login is EMAIL OTP. Set AUTH_PHONE_OTP_ENABLED=true to re-enable phone login.
AUTH_PHONE_OTP_ENABLED=false
SMS_PROVIDER=mock
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ----- Web Push (VAPID) — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())" -----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@globalsimify.com

# ----- Auth (CHANGE THESE IN PRODUCTION) -----
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
